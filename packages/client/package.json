{
  "name": "@reactor-team/queue",
  "version": "0.1.0",
  "description": "Client for the Reactor demo queue: a framework-agnostic WebSocket client plus a React/zustand layer that exposes a getJwt resolver you drop straight into the Reactor SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./admin": {
      "types": "./dist/admin-client.d.ts",
      "import": "./dist/admin-client.js",
      "require": "./dist/admin-client.cjs"
    },
    "./admin/react": {
      "types": "./dist/admin-react.d.ts",
      "import": "./dist/admin-react.js",
      "require": "./dist/admin-react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reactor-team/queue-protocol": "workspace:*",
    "partysocket": "^1.1.19"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "zustand": "^5.0.2"
  }
}
