# Copy to `.env` and fill in. `.env` is gitignored.
#
# This file holds only two kinds of value: where the browser finds the queue,
# and the server's secrets. How the queue *behaves* (model, caps, durations) is
# configured in code, in `partykit/server.ts` — not here.

# ── Browser (Next.js) ───────────────────────────────────────────────────────

# Where the browser reaches the PartyKit room. Local dev: the address
# `partykit dev` prints (the default below). Production: your deployed host,
# e.g. reactor-queue-basic.<your-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# ── Server secrets (PartyKit) — never exposed to the browser ────────────────

# Your Reactor API key (rk_...). Used ONLY by the queue server to mint
# short-lived JWTs, create sessions, and stop them — it never reaches the
# browser. `partykit dev` loads this `.env` automatically; in production set it
# as a PartyKit secret instead: `npx partykit secret put RQ_REACTOR_API_KEY`.
RQ_REACTOR_API_KEY=rk_your_key_here

# Admin dashboard (/admin) password. DEMO DEFAULT ONLY — `admin` is a throwaway
# for local dev. Use a real secret in production:
#   npx partykit secret put RQ_ADMIN_PASSWORD
RQ_ADMIN_PASSWORD=admin
