# Copy to `.env` and fill in. `.env` is gitignored.

# Where the browser finds the PartyKit room. For local dev this is the address
# `partykit dev` prints (default below). For production use your deployed host,
# e.g. reactor-queue-basic.<your-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Your Reactor API key (rk_...). Used ONLY by the PartyKit server to mint
# short-lived JWTs and stop sessions — it is never exposed to the browser.
# `partykit dev` loads this .env automatically and exposes it on room.env.
RQ_REACTOR_API_KEY=rk_your_key_here
