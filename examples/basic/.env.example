# Copy to `.env` and fill in. `.env` is gitignored.

# Where the browser finds the PartyKit room. For local dev this is the address
# `partykit dev` prints (default below). For production use your deployed host,
# e.g. reactor-queue-basic.<your-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Your Reactor API key (rk_...). Used ONLY by the PartyKit server to mint
# short-lived JWTs, create sessions, and stop them — never exposed to the browser.
# `partykit dev` loads this .env automatically and exposes it on room.env.
RQ_REACTOR_API_KEY=rk_your_key_here

# Model the queue server creates via POST /sessions (must match the client demo).
# Also set in partykit.json `vars` for deploy; .env overrides locally.
# RQ_MODEL=helios

# Admin dashboard (/admin). Loaded by `partykit dev` onto room.env — do not put in partykit.json.
# Never add to NEXT_PUBLIC_* (server-only secret).
RQ_ADMIN_PASSWORD=admin

# Optional: lease sessions from a pre-provisioned pool (e.g. each already has a
# backend "robot" connected) instead of creating them on claim. See README → Session pools.
# RQ_SESSION_POOL_URL=https://your-pool.example.com
# RQ_SESSION_POOL_TOKEN=your-pool-token
