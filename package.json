{
  "name": "reactor-queue",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "description": "Drop-in waiting-room / queue gating for Reactor demos. PartyKit server + JS/React client that mints short-lived Reactor JWTs only to admitted users.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:coverage": "pnpm -r --filter \"./packages/*\" test:coverage",
    "clean": "pnpm -r exec rm -rf dist .turbo",
    "example": "pnpm --filter @reactor-team/queue-example-basic dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:license": "./scripts/check-license.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
