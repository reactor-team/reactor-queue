{
  "name": "reactor-queue",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in waiting-room / queue gating for Reactor demos. PartyKit server + JS/React client that mints short-lived Reactor JWTs only to admitted users.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "clean": "pnpm -r exec rm -rf dist .turbo",
    "example": "pnpm --filter @reactor-team/queue-example-basic dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
